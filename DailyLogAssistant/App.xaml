<Application x:Class="DailyLogAssistant.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:DailyLogAssistant.Views"
             ShutdownMode="OnExplicitShutdown">
  <Application.Resources>
    <SolidColorBrush x:Key="AccentBrush" Color="#315C4C" />
    <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    <local:DateOnlyDateTimeConverter x:Key="DateOnlyDateTimeConverter" />
    <Style TargetType="Button">
      <Setter Property="Padding" Value="14,8" />
      <Setter Property="Margin" Value="4" />
      <Setter Property="MinHeight" Value="34" />
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Padding" Value="9" />
      <Setter Property="Margin" Value="0,5,0,12" />
      <Setter Property="AcceptsReturn" Value="True" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
      <Setter Property="MinHeight" Value="72" />
    </Style>
  </Application.Resources>
</Application>
