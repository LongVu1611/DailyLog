<Application x:Class="DailyLogAssistant.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:DailyLogAssistant.Views"
             xmlns:loc="clr-namespace:DailyLogAssistant.Localization"
             ShutdownMode="OnExplicitShutdown">
  <Application.Resources>
    <SolidColorBrush x:Key="AccentBrush" Color="#315C4C" />
    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#F4F6F3" />
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="White" />
    <SolidColorBrush x:Key="PrimaryTextBrush" Color="#24352D" />
    <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    <local:DateOnlyDateTimeConverter x:Key="DateOnlyDateTimeConverter" />
    <loc:LocalizedTextConverter x:Key="LocalizedTextConverter" />
    <DataTemplate x:Key="LocalizedOptionTemplate">
      <TextBlock>
        <TextBlock.Text>
          <MultiBinding Converter="{StaticResource LocalizedTextConverter}">
            <Binding/>
            <Binding Source="{x:Static loc:LocalizationService.Instance}" Path="Language"/>
          </MultiBinding>
        </TextBlock.Text>
      </TextBlock>
    </DataTemplate>
    <Style TargetType="Button">
      <Setter Property="Padding" Value="12,7" />
      <Setter Property="Margin" Value="4" />
      <Setter Property="MinHeight" Value="34" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Padding" Value="8" />
      <Setter Property="Margin" Value="0,4,0,8" />
      <Setter Property="AcceptsReturn" Value="True" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
      <Setter Property="MinHeight" Value="36" />
    </Style>
    <Style TargetType="ComboBox">
      <Setter Property="Padding" Value="7,4" />
      <Setter Property="Margin" Value="0,4,0,8" />
    </Style>
  </Application.Resources>
</Application>
