<Window x:Class="DailyLogAssistant.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Daily Log Assistant" Height="780" Width="1180"
        MinHeight="650" MinWidth="900" Background="#F4F6F3"
        WindowStartupLocation="CenterScreen">
  <Grid Margin="20">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="205"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>
    <Border Grid.Column="0" Background="#263C34" CornerRadius="14" Padding="16" Margin="0,0,18,0">
      <DockPanel>
        <StackPanel DockPanel.Dock="Top">
          <TextBlock Text="DAILY LOG" Foreground="White" FontSize="22" FontWeight="SemiBold" Margin="4,8,4,24"/>
          <Button Content="Dashboard" Command="{Binding NavigateCommand}" CommandParameter="Dashboard"/>
          <Button Content="Daily Log" Command="{Binding NavigateCommand}" CommandParameter="Daily Log"/>
          <Button Content="History" Command="{Binding NavigateCommand}" CommandParameter="History"/>
          <Button Content="Statistics" Command="{Binding NavigateCommand}" CommandParameter="Statistics"/>
          <Button Content="Settings" Command="{Binding NavigateCommand}" CommandParameter="Settings"/>
        </StackPanel>
        <TextBlock DockPanel.Dock="Bottom" Text="{Binding StatusMessage}" Foreground="#C9D7D0"
                   TextWrapping="Wrap" Margin="4,12,4,4"/>
      </DockPanel>
    </Border>
    <Grid Grid.Column="1">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <DockPanel Grid.Row="0" Margin="0,0,0,18">
        <TextBlock Text="{Binding TodayText}" FontSize="16" Foreground="#59645E" VerticalAlignment="Center"/>
        <Button DockPanel.Dock="Right" Content="Write today's log" Command="{Binding OpenTodayCommand}"/>
      </DockPanel>
      <TabControl Grid.Row="1" SelectedValue="{Binding ActiveSection}" SelectedValuePath="Header">
        <TabItem Header="Dashboard">
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="16">
              <TextBlock Text="Your day, in review." FontSize="32" FontWeight="SemiBold" Foreground="#24352D"/>
              <TextBlock Text="{Binding TodayStatus}" FontSize="18" Margin="0,12,0,20"/>
              <UniformGrid Columns="3" Margin="0,0,0,18">
                <Border Background="White" CornerRadius="10" Padding="18" Margin="4"><StackPanel><TextBlock Text="TOTAL LOGS"/><TextBlock Text="{Binding Statistics.Total}" FontSize="30" FontWeight="SemiBold"/></StackPanel></Border>
                <Border Background="White" CornerRadius="10" Padding="18" Margin="4"><StackPanel><TextBlock Text="CURRENT STREAK"/><TextBlock Text="{Binding Statistics.CurrentStreak}" FontSize="30" FontWeight="SemiBold"/></StackPanel></Border>
                <Border Background="White" CornerRadius="10" Padding="18" Margin="4"><StackPanel><TextBlock Text="THIS MONTH"/><TextBlock Text="{Binding Statistics.ThisMonth}" FontSize="30" FontWeight="SemiBold"/></StackPanel></Border>
              </UniformGrid>
              <TextBlock Text="Today's summary" FontSize="19" FontWeight="SemiBold"/>
              <Border Background="White" CornerRadius="10" Padding="18" Margin="0,8,0,16">
                <TextBlock Text="{Binding TodaySummary}" TextWrapping="Wrap" MinHeight="100"/>
              </Border>
              <TextBlock Text="{Binding ReminderTimeText}" Foreground="#59645E"/>
            </StackPanel>
          </ScrollViewer>
        </TabItem>
        <TabItem Header="Daily Log">
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="16">
              <DockPanel Margin="0,0,0,16">
                <TextBlock Text="Daily log" FontSize="29" FontWeight="SemiBold" Foreground="#24352D" VerticalAlignment="Center"/>
                <DatePicker DockPanel.Dock="Right" SelectedDate="{Binding SelectedDate, Mode=TwoWay, Converter={StaticResource DateOnlyDateTimeConverter}}"/>
              </DockPanel>
              <TextBlock Text="What did you work on today?" FontWeight="SemiBold"/>
              <TextBox Text="{Binding WorkDone, UpdateSourceTrigger=PropertyChanged}" Height="110"/>
              <TextBlock Text="Problems / Blockers" FontWeight="SemiBold"/>
              <TextBox Text="{Binding Problems, UpdateSourceTrigger=PropertyChanged}" Height="80"/>
              <TextBlock Text="Plan for tomorrow" FontWeight="SemiBold"/>
              <TextBox Text="{Binding TomorrowPlan, UpdateSourceTrigger=PropertyChanged}" Height="80"/>
              <TextBlock Text="Additional notes" FontWeight="SemiBold"/>
              <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" Height="80"/>
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Snooze 15 min" Command="{Binding SnoozeCommand}" CommandParameter="15" Visibility="{Binding IsReminderOpen, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    <Button Content="Snooze 30 min" Command="{Binding SnoozeCommand}" CommandParameter="30" Visibility="{Binding IsReminderOpen, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    <Button Content="Snooze 1 hour" Command="{Binding SnoozeCommand}" CommandParameter="60" Visibility="{Binding IsReminderOpen, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    <Button Content="Save log" Command="{Binding SaveLogCommand}" IsDefault="True"/>
              </StackPanel>
            </StackPanel>
          </ScrollViewer>
        </TabItem>
        <TabItem Header="History">
          <DockPanel Margin="16">
            <StackPanel DockPanel.Dock="Top">
              <TextBlock Text="Your history" FontSize="29" FontWeight="SemiBold" Margin="0,0,0,12"/>
              <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="False" MinHeight="36" ToolTip="Search all log fields"/>
              <WrapPanel Margin="0,0,0,8" VerticalAlignment="Center">
                <TextBlock Text="Date range" VerticalAlignment="Center" Margin="4"/>
                <ComboBox Width="150" ItemsSource="{Binding HistoryFilters}"
                          SelectedItem="{Binding HistoryFilter}" Margin="4"/>
                <TextBlock Text="From" VerticalAlignment="Center" Margin="8,0,2,0"/>
                <DatePicker SelectedDate="{Binding HistoryStartDate, Converter={StaticResource DateOnlyDateTimeConverter}}"/>
                <TextBlock Text="To" VerticalAlignment="Center" Margin="8,0,2,0"/>
                <DatePicker SelectedDate="{Binding HistoryEndDate, Converter={StaticResource DateOnlyDateTimeConverter}}"/>
              </WrapPanel>
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,10">
                <Button Content="Edit selected" Command="{Binding OpenLogCommand}" CommandParameter="{Binding SelectedLog}"/>
                <Button Content="Delete selected" Click="DeleteSelected_Click"/>
                <Button Content="Export CSV" Click="ExportCsv_Click"/>
                <Button Content="Export Markdown" Click="ExportMarkdown_Click"/>
              </StackPanel>
            </StackPanel>
            <ListView ItemsSource="{Binding History}" SelectedItem="{Binding SelectedLog}" MouseDoubleClick="History_DoubleClick">
              <ListView.View>
                <GridView>
                  <GridViewColumn Header="Date" Width="150" DisplayMemberBinding="{Binding Date, StringFormat={}{0:ddd, d MMM yyyy}}"/>
                  <GridViewColumn Header="Work summary" Width="380" DisplayMemberBinding="{Binding WorkDone}"/>
                  <GridViewColumn Header="Updated" Width="150" DisplayMemberBinding="{Binding UpdatedAt, StringFormat={}{0:g}}"/>
                </GridView>
              </ListView.View>
            </ListView>
          </DockPanel>
        </TabItem>
        <TabItem Header="Statistics">
          <StackPanel Margin="24">
            <TextBlock Text="Statistics" FontSize="30" FontWeight="SemiBold" Margin="0,0,0,20"/>
            <TextBlock Text="{Binding Statistics.Total, StringFormat='Total logs: {0}'}" FontSize="20" Margin="0,8"/>
            <TextBlock Text="{Binding Statistics.CurrentStreak, StringFormat='Current streak: {0} days'}" FontSize="20" Margin="0,8"/>
            <TextBlock Text="{Binding Statistics.LongestStreak, StringFormat='Longest streak: {0} days'}" FontSize="20" Margin="0,8"/>
            <TextBlock Text="{Binding Statistics.ThisMonth, StringFormat='Logs this month: {0}'}" FontSize="20" Margin="0,8"/>
            <TextBlock Text="{Binding Statistics.CompletionRate, StringFormat='Calendar-day completion: {0}%'}" FontSize="20" Margin="0,8"/>
          </StackPanel>
        </TabItem>
        <TabItem Header="Settings">
          <StackPanel Margin="24" MaxWidth="620" HorizontalAlignment="Left">
            <TextBlock Text="Settings" FontSize="30" FontWeight="SemiBold" Margin="0,0,0,20"/>
            <TextBlock Text="Reminder time (24-hour)"/>
            <TextBox Text="{Binding Settings.ReminderTime, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="False"/>
            <CheckBox Content="Enable daily reminder" IsChecked="{Binding Settings.ReminderEnabled}" Margin="4,8"/>
            <CheckBox Content="Start application with Windows" IsChecked="{Binding Settings.StartWithWindows}" Margin="4,8"/>
            <CheckBox Content="Minimize to tray" IsChecked="{Binding Settings.MinimizeToTray}" Margin="4,8"/>
            <CheckBox Content="Launch log window automatically" IsChecked="{Binding Settings.LaunchLogAutomatically}" Margin="4,8"/>
            <CheckBox Content="Show Windows notification" IsChecked="{Binding Settings.ShowNotification}" Margin="4,8"/>
            <WrapPanel Margin="0,16,0,0">
              <Button Content="Save settings" Command="{Binding SaveSettingsCommand}"/>
              <Button Content="Test reminder now" Command="{Binding TestReminderCommand}"/>
              <Button Content="Export database backup" Click="Backup_Click"/>
            </WrapPanel>
          </StackPanel>
        </TabItem>
      </TabControl>
      <Border Background="#FFF5D9" CornerRadius="10" Padding="16" Margin="32"
              VerticalAlignment="Top" Visibility="{Binding IsReminderOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
        <DockPanel>
          <StackPanel>
            <TextBlock Text="Daily Log Reminder" FontWeight="Bold" FontSize="18"/>
            <TextBlock Text="It's time to capture what you worked on today." Margin="0,4,12,0"/>
          </StackPanel>
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
            <Button Content="Snooze 15 min" Command="{Binding SnoozeCommand}" CommandParameter="15"/>
            <Button Content="Snooze 30 min" Command="{Binding SnoozeCommand}" CommandParameter="30"/>
            <Button Content="Snooze 1 hour" Command="{Binding SnoozeCommand}" CommandParameter="60"/>
            <Button Content="Dismiss today" Command="{Binding DismissReminderCommand}"/>
          </StackPanel>
        </DockPanel>
      </Border>
    </Grid>
  </Grid>
</Window>
