<Window x:Class="DailyLogAssistant.Views.QuickAddWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:DailyLogAssistant.Localization"
        Title="{loc:Translate 'Quick add'}" Width="520" SizeToContent="Height"
        MinWidth="420" ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        Language="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=CurrentXmlLanguage}"
        Background="{DynamicResource AppBackgroundBrush}">
  <Window.Resources>
    <Style TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
    </Style>
  </Window.Resources>
  <StackPanel Margin="22">
    <TextBlock Text="{loc:Translate 'Quick add'}" FontSize="26" FontWeight="SemiBold"
               Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,14"/>
    <TextBlock Text="{loc:Translate 'Log type'}"/>
    <ComboBox ItemsSource="{Binding Categories}" DisplayMemberPath="DisplayName"
              Background="{DynamicResource CardBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}"
              SelectedItem="{Binding QuickAddCategory}"/>
    <TextBlock Text="{loc:Translate Title}"/>
    <TextBox Text="{Binding QuickAddTitle, UpdateSourceTrigger=PropertyChanged}"
             Background="{DynamicResource CardBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}"
             AcceptsReturn="False"/>
    <TextBlock Text="{loc:Translate 'Main content'}"/>
    <TextBox Text="{Binding QuickAddContent, UpdateSourceTrigger=PropertyChanged}"
             Background="{DynamicResource CardBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}"
             MinHeight="145" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>
    <TextBlock Text="{loc:Translate 'Work status (used for Work logs)'}"/>
    <ComboBox ItemsSource="{Binding StatusOptions}" ItemTemplate="{StaticResource LocalizedOptionTemplate}" SelectedItem="{Binding QuickAddStatus}"
              Background="{DynamicResource CardBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}"/>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
      <Button Content="{loc:Translate Cancel}" IsCancel="True"/>
      <Button Content="{loc:Translate 'Save log'}" Command="{Binding SaveQuickAddCommand}" IsDefault="True"/>
    </StackPanel>
  </StackPanel>
</Window>
